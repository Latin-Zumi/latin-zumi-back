{
    "compilerOptions": {
        /*----< Language and  Environment >----*/
        "target": "ES2025",
        "lib": [ "ES2025"],
        "types": ["node"],

        /*----< Modules >----*/
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        /*----< Emit >----*/
        "rootDir": "./src",
        "outDir": "./dist",
        "sourceMap": true,

        /*----< Type Checking >----*/
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        /*----< Completeness >----*/
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    }
}
