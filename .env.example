# DATABASE_URL is the pooled connection URL used by the running app and takes
# precedence over all DB_* values when it is set. For Neon, use the -pooler
# hostname here. Schema migrations should use DATABASE_URL_UNPOOLED (direct URL)
# instead; the Render build command maps it to DATABASE_URL for db:init.
# For a remote provider, specify sslmode=verify-full (or require, normalized
# to verify-full by this app). See db/README.md for supported SSL URL options.
# Keep the real value in .env or the deployment secret manager, never in Git.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Local PostgreSQL fallback. Required fields when DATABASE_URL is empty.
# These values can be used without TLS for a local development database.
DB_HOST=
DB_PORT= # puerto de la DB
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=2000
EXCHANGE_RATE_TIMEOUT_MS=3000
EXCHANGE_RATE_MAX_AGE_HOURS=24
PORT=3000 # puerto donde node/express escucha peticiones

# Comma-separated exact browser origins (scheme + host + optional port).
# Local development value for the frontend running on Vite (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# In Render, set the exact deployed frontend origin(s), separated by commas,
# without wildcards and without paths. For example:
# CORS_ORIGINS=https://<dominio-de-vercel>
# Do not use "*"; the backend requires exact origins. Requests without an
# Origin header stay allowed for health checks and server-to-server clients.

# Gemini AI assistant configuration.
# Set GEMINI_API_KEY in the local .env file or the deployment secret manager,
# never in Git. If it is unset, the chatbot endpoint returns a controlled
# 503 response instead of exposing internal errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Admin (service account). Leave all three empty to disable Google auth.
# Store the private key with escaped \n sequences; the backend restores newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
